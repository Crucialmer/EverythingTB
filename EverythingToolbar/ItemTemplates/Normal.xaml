<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:app="clr-namespace:EverythingToolbar.App;assembly=EverythingToolbar.App"
  xmlns:b="clr-namespace:EverythingToolbar.Behaviors"
  xmlns:c="clr-namespace:EverythingToolbar.Converters"
  xmlns:h="clr-namespace:EverythingToolbar.Helpers"
  xmlns:markup="clr-namespace:EverythingToolbar.Markup">
  <DataTemplate x:Key="Normal">
    <Grid x:Name="ListViewItem" Margin="2 3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="38" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Image
        Width="18"
        Height="18"
        VerticalAlignment="Center"
        RenderOptions.BitmapScalingMode="HighQuality"
        SnapsToDevicePixels="True"
        b:ResultIcon.Result="{Binding Mode=OneTime}" />
      <TextBlock
        Grid.Column="1"
        Margin="0 4"
        VerticalAlignment="Center"
        h:HighlightedText.Source="{Binding HighlightedFileName, Mode=OneTime}"
        FontSize="{Binding Source={markup:Service {x:Type app:ISettings}}, Path=ResultFontSize, Converter={c:ResultFontSizeConverter}}"
        FontWeight="{Binding Source={markup:Service {x:Type app:ISettings}}, Path=ResultFontWeight, Converter={c:SafeFontWeightConverter}}"
        Foreground="{DynamicResource SearchResultFileName}"
        TextTrimming="CharacterEllipsis"
        ToolTip="{Binding FileName, Mode=OneTime}" />
      <TextBlock
        Grid.Column="2"
        Margin="10 4"
        VerticalAlignment="Center"
        FontSize="{Binding Source={markup:Service {x:Type app:ISettings}}, Path=ResultFontSize, Converter={c:ResultFontSizeConverter}, ConverterParameter='-1.5'}"
        Foreground="{DynamicResource SearchResultDateModified}"
        Text="{Binding HumanReadableDateModified, Mode=OneTime}" />
    </Grid>
  </DataTemplate>
</ResourceDictionary>
