<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:app="clr-namespace:EverythingToolbar.App;assembly=EverythingToolbar.App"
  xmlns:b="clr-namespace:EverythingToolbar.Behaviors"
  xmlns:c="clr-namespace:EverythingToolbar.Converters"
  xmlns:h="clr-namespace:EverythingToolbar.Helpers"
  xmlns:markup="clr-namespace:EverythingToolbar.Markup">
  <DataTemplate x:Key="NormalDetailed">
    <Grid x:Name="ListViewItem" Margin="2 3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="48" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Image
        Grid.RowSpan="2"
        Width="24"
        Height="24"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        RenderOptions.BitmapScalingMode="HighQuality"
        SnapsToDevicePixels="True"
        b:ResultIcon.Result="{Binding Mode=OneTime}" />
      <TextBlock
        Grid.Column="1"
        Margin="0 4 0 2"
        VerticalAlignment="Bottom"
        h:HighlightedText.Source="{Binding HighlightedFileName, Mode=OneTime}"
        FontSize="{Binding Source={markup:Service {x:Type app:ISettings}}, Path=ResultFontSize, Converter={c:ResultFontSizeConverter}}"
        FontWeight="{Binding Source={markup:Service {x:Type app:ISettings}}, Path=ResultFontWeight, Converter={c:SafeFontWeightConverter}}"
        Foreground="{DynamicResource SearchResultFileName}"
        TextTrimming="CharacterEllipsis"
        ToolTip="{Binding FileName, Mode=OneTime}" />
      <TextBlock
        Grid.Row="1"
        Grid.Column="1"
        Margin="0 1 0 3"
        VerticalAlignment="Top"
        h:HighlightedText.Source="{Binding HighlightedPath, Mode=OneTime}"
        FontSize="{Binding Source={markup:Service {x:Type app:ISettings}}, Path=ResultFontSize, Converter={c:ResultFontSizeConverter}, ConverterParameter='-1.5'}"
        Foreground="{DynamicResource SearchResultPath}"
        TextTrimming="CharacterEllipsis"
        ToolTip="{Binding Path, Mode=OneTime}" />
      <TextBlock
        Grid.Column="2"
        Margin="10 4 10 2"
        VerticalAlignment="Bottom"
        FontSize="{Binding Source={markup:Service {x:Type app:ISettings}}, Path=ResultFontSize, Converter={c:ResultFontSizeConverter}, ConverterParameter='-1.5'}"
        Foreground="{DynamicResource SearchResultDateModified}"
        Text="{Binding HumanReadableDateModified, Mode=OneTime}" />
      <TextBlock
        Grid.Row="1"
        Grid.Column="2"
        Margin="10 1 10 3"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        FontSize="{Binding Source={markup:Service {x:Type app:ISettings}}, Path=ResultFontSize, Converter={c:ResultFontSizeConverter}, ConverterParameter='-1.5'}"
        Foreground="{DynamicResource SearchResultFileSize}"
        Text="{Binding HumanReadableFileSize, Mode=OneTime}" />
    </Grid>
  </DataTemplate>
</ResourceDictionary>
