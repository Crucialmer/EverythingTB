<UserControl
  x:Class="EverythingToolbar.Controls.DateWidget"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:app="clr-namespace:EverythingToolbar.App;assembly=EverythingToolbar.App"
  xmlns:c="clr-namespace:EverythingToolbar.Converters"
  xmlns:markup="clr-namespace:EverythingToolbar.Markup"
  SnapsToDevicePixels="True"
  UseLayoutRounding="True"
  VerticalAlignment="Stretch">
  <Border
    x:Name="PillBorder"
    Background="{DynamicResource TextBoxBackground}"
    BorderBrush="{DynamicResource TextBoxBorder}"
    BorderThickness="1"
    CornerRadius="{DynamicResource DateWidgetCornerRadius}"
    Padding="10 0"
    Cursor="Hand"
    ToolTipService.ShowDuration="12000"
    PreviewMouseLeftButtonUp="OnWidgetClicked">
    <Border.Style>
      <Style TargetType="Border">
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorderHover}" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock
        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
        FontSize="12"
        Text="&#xE787;"
        Foreground="{DynamicResource SearchResultHighlightColor}"
        VerticalAlignment="Center"
        Margin="0 0 6 0" />
      <TextBlock
        x:Name="DateText"
        VerticalAlignment="Center"
        FontWeight="Medium"
        Foreground="{DynamicResource TextBoxForeground}"
        FontSize="{Binding Source={markup:Service {x:Type app:ISettings}}, Path=SearchBoxFontSize, Converter={c:ResultFontSizeConverter}, ConverterParameter='-0.5'}"
        FontFamily="{Binding Source={markup:Service {x:Type app:ISettings}}, Path=FontFamily, Converter={c:FontFamilyConverter}}" />
    </StackPanel>
  </Border>
</UserControl>
